# ISTE-CGC website environment variables
# Copy this file to .env.local (for local dev) and fill in real values.
# On Vercel: Project Settings -> Environment Variables -> add the same keys.
#
# NOTE: only the Contact form needs any of this. The rest of the site
# (home, team, events, gallery, partners) is fully static and needs none of
# these variables to run.

# Where contact-form submissions get delivered.
CONTACT_EMAIL=

# SMTP credentials used to SEND that email (the account the message is
# sent "from"). Using Gmail? You need an "App Password", not your normal
# Gmail password -- see MANUAL SETUP in the project docs for the steps.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
